# Скопировать в `.env` на production-хосте; никогда не коммитить.
#
# Заполняется секрет-менеджером в Phase 0.13 (sops / Selectel Secrets Manager).
# Пока — вручную на VPS.

# === Базы и Redis (внутри docker-сети) =====================================
KW_DB_SUPER_PASSWORD=replace-me-postgres-superuser
KW_DB_ADMIN_PASSWORD=replace-me-khubiy-admin-bypassrls
KW_DB_APP_PASSWORD=replace-me-khubiy-app-runtime

# === Sentry ================================================================
KW_SENTRY_DSN=

# === Traefik ===============================================================
TRAEFIK_ACME_EMAIL=admin@khubiyinc.ru
# DNS-провайдер для wildcard-сертификата.
# Поддерживается полный список: https://doc.traefik.io/traefik/https/acme/#providers
TRAEFIK_DNS_PROVIDER=cloudflare
CF_API_EMAIL=
CF_DNS_API_TOKEN=

# === API image tag =========================================================
# В прод деплое тег ставит GitHub Actions (см. Phase 0.11 deploy workflow).
API_IMAGE_TAG=latest
