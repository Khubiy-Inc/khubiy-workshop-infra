# Caddyfile для production KhubiyInc Workshop.
#
# Caddy автоматически:
# - получает Let's Encrypt cert'ы (HTTP-01 challenge на :80)
# - редиректит HTTP → HTTPS
# - добавляет security headers
#
# Файл подключается через docker-compose volume.
#
# ВАЖНО: этот Caddy — ЕДИНСТВЕННЫЙ ingress (:80/:443) на общем VPS и
# обслуживает НЕСКОЛЬКО проектов (khubiy + co-located сайты ниже). Все
# обслуживаемые домены ОБЯЗАНЫ быть в этом файле. Применять изменения
# ТОЛЬКО graceful-перечиткой (атомарно, zero-downtime):
#   docker exec khubiy-workshop-prod-caddy-1 \
#     caddy reload --config /etc/caddy/Caddyfile --adapter caddyfile
# НЕ делать `docker compose restart/up -d caddy` и не стартовать caddy без
# всех блоков ниже — иначе co-located сайты (apteka/quests) исчезнут из
# конфига (они подцеплены только через этот файл).

{
    # Email для Let's Encrypt — подставляется через ENV ACME_EMAIL
    email admin@khubiyinc.ru
    # Метрики Prometheus (опц.)
    servers {
        metrics
    }
}

# ============================================================================
# Главный домен — Web SPA (frontend) + reverse-proxy /api/* в backend
# ============================================================================

workshop.khubiyinc.ru {
    # /api/* идёт в FastAPI; всё остальное — в nginx с SPA-бандлом
    handle_path /api* {
        # rewrite добавляет /api обратно (мы только path stripped через handle_path).
        # Backend ожидает /api/v1/...
        rewrite * /api{path}
        reverse_proxy api:8000 {
            health_uri /health
            health_interval 30s
            health_timeout 5s
        }
    }

    # Стандартные security headers
    header {
        Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
        -Server
        -X-Powered-By
    }

    # Web SPA — nginx внутри web-контейнера на :80
    reverse_proxy web:80
}

# ============================================================================
# Legacy-редирект: старый домен app.* → workshop.* (сохраняем старые ссылки/закладки)
# ============================================================================

app.khubiyinc.ru {
    redir https://workshop.khubiyinc.ru{uri} permanent
}

# ============================================================================
# MinIO console (опц., только для админа)
# ============================================================================

minio.khubiyinc.ru {
    header {
        Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        -Server
    }
    reverse_proxy minio:9001
}

# ============================================================================
# Co-located сайты на этом же общем VPS-ingress (не khubiy-проекты, но один
# Caddy/один VPS — все владельца). Обязаны быть здесь, иначе reload/restart
# их потеряет. Воспроизведены 1-в-1 из рантайм-конфига Caddy.
# ============================================================================

apteka.uiyy.ru {
    handle_path /api* {
        rewrite * /api{path}
        reverse_proxy apteka-backend:8000 {
            health_uri /health
            health_interval 30s
        }
    }
    header {
        Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        -Server
    }
    reverse_proxy apteka-frontend:3000
}

questss.ncsa.uiyy.ru {
    header {
        Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        -Server
    }
    reverse_proxy abi-quests-frontend-1:80
}

# ============================================================================
# Apex redirect (khubiyinc.ru → workshop.khubiyinc.ru)
# ============================================================================

khubiyinc.ru, www.khubiyinc.ru {
    redir https://workshop.khubiyinc.ru{uri} permanent
}
