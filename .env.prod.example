# =============================================================================
# .env.prod — конфигурация production-стенда KhubiyInc Workshop.
#
# 1. Скопировать в `.env` рядом с docker-compose.prod.yml на VPS:
#      cp .env.prod.example .env
# 2. Заполнить ВСЕ значения (особенно секреты!).
# 3. Не коммитить .env в git — добавлен в .gitignore.
# =============================================================================

# --- Домены / TLS -----------------------------------------------------------

# Главный домен. Используется в шаблонах для app.${DOMAIN}, api.${DOMAIN}, etc.
KW_PRIMARY_DOMAIN=khubiyinc.ru

# Email для уведомлений Let's Encrypt (expiry warnings + abuse).
TRAEFIK_ACME_EMAIL=admin@khubiyinc.ru

# Если переключаемся на DNS-01 challenge через Selectel (для wildcard cert) —
# заполнить и раскомментить dnschallenge в docker-compose.prod.yml.
# SELECTEL_API_TOKEN=

# --- Postgres ---------------------------------------------------------------

# Суперпользователь — используется внутри контейнера только для init-скрипта.
# Никогда не переиспользуется приложением.
KW_DB_SUPER_PASSWORD=CHANGE_ME_super_strong

# Технические user'ы. Создаются в `postgres/init/01-roles-and-extensions.sql`.
# Должны совпадать с тем что задано в init-скрипте + ENV ниже.
KW_DB_ADMIN_PASSWORD=CHANGE_ME_admin
KW_DB_APP_PASSWORD=CHANGE_ME_app

# --- WebPush VAPID ----------------------------------------------------------
# Генерируется один раз: `npx web-push generate-vapid-keys`
KW_WEBPUSH_VAPID_PUBLIC_KEY=CHANGE_ME_vapid_public
KW_WEBPUSH_VAPID_PRIVATE_KEY=CHANGE_ME_vapid_private
KW_WEBPUSH_VAPID_EMAIL=admin@khubiyinc.ru

# --- MinIO / S3 -------------------------------------------------------------
# Access key и secret для MinIO root (используется backend'ом для presigned upload).
# Сгенерировать: `openssl rand -hex 16` для key, `openssl rand -hex 32` для secret.
KW_S3_ACCESS_KEY=CHANGE_ME_access_key_16hex
KW_S3_SECRET_KEY=CHANGE_ME_secret_key_32hex
KW_S3_BUCKET=khubiy-workshop
KW_S3_REGION=ru-1

# --- SMTP (email-провайдер) -------------------------------------------------
# Для приглашений тенантам / уведомлений. На старте можно оставить пустым —
# emailservice кинет warning при попытке отправить.
# Пример Unisender Go SMTP:
#   KW_SMTP_HOST=smtp.unisender.com
#   KW_SMTP_PORT=587
#   KW_SMTP_USER=apikey
#   KW_SMTP_PASSWORD=<API_KEY>
KW_SMTP_HOST=
KW_SMTP_PORT=587
KW_SMTP_USER=
KW_SMTP_PASSWORD=
KW_SMTP_FROM=noreply@khubiyinc.ru

# --- Sentry (опционально) ---------------------------------------------------
KW_SENTRY_DSN=
KW_SENTRY_TRACES_SAMPLE_RATE=0.05

# --- Image tags (CI/CD передаёт через переменную) ----------------------------
# По умолчанию compose pull'нет `latest`. CI может перебить на конкретный sha.
API_IMAGE_TAG=latest
WEB_IMAGE_TAG=latest
